# ─────────────────────────────────────────────────────────────
#  Ecojindu Shuttle — Core Backend Service (.env)
#  Copy to `.env` and fill in.  Every value below is 12-factor
#  config: nothing is hard-coded in the source tree.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
DEBUG=true
APP_NAME="Ecojindu Shuttle Backend"
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production (Cloud Logging friendly)

# ── Database ─────────────────────────────────────────────────
# Async driver is required (asyncpg). Alembic derives the sync URL itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecojindu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── JWT auth ─────────────────────────────────────────────────
JWT_SECRET=dev-change-me-super-secret-jwt-key-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Ticket QR signing (HMAC) ─────────────────────────────────
# Rotating this invalidates every already-issued QR ticket.
TICKET_HMAC_SECRET=dev-change-me-ticket-hmac-secret-9876543210
QR_STORAGE_DIR=./storage/qr
PUBLIC_BASE_URL=http://localhost:8000

# ── Service-to-service auth ──────────────────────────────────
# ecojindu-api authenticates to this backend with this key.
SERVICE_API_KEY=dev-service-key-change-me

# ── Paystack ─────────────────────────────────────────────────
# Test keys work end-to-end in Paystack test mode.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/booking/callback
# Leave PAYSTACK_MOCK=true to run the whole flow locally with no live keys.
PAYSTACK_MOCK=true

# ── Email (SMTP abstraction: Gmail / SendGrid / Resend / Mailtrap) ──
EMAIL_ENABLED=true
EMAIL_PROVIDER=console            # console | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=jinduinc@gmail.com
EMAIL_FROM_NAME="Ecojindu Shuttle"
# SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_USERNAME=apikey  SMTP_PASSWORD=<SG. key>
# Resend:    SMTP_HOST=smtp.resend.com    SMTP_USERNAME=resend  SMTP_PASSWORD=<re_ key>

# ── SMS (Termii primary, Twilio fallback) ────────────────────
SMS_ENABLED=true
SMS_PROVIDER=console              # console | termii | twilio
TERMII_API_KEY=
TERMII_SENDER_ID=Ecojindu
TERMII_BASE_URL=https://api.ng.termii.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15005550006

# ── Scheduler (APScheduler background jobs) ──────────────────
SCHEDULER_ENABLED=true
TRIP_GENERATION_DAYS_AHEAD=14
SEAT_HOLD_MINUTES=10

# ── Upload & Go / ticket reading (Anthropic vision) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CHECK_IN_BUFFER_HOURS=2.5
TICKET_READ_MAX_BYTES=10485760
TICKET_READ_RATE_LIMIT_PER_MINUTE=10
# Hours before shuttle departure to send reminders (comma-separated).
REMINDER_OFFSETS_HOURS=24,3,1

# ── Cloud Tasks (optional; when false, APScheduler polls windows) ──
CLOUD_TASKS_ENABLED=false
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=ecojindu-reminders
# Public base URL that receives task POSTs, e.g. https://api.ecojindu.ng
CLOUD_TASKS_SERVICE_URL=

# ── Flight status (AviationStack; optional) ──────────────────
AVIATIONSTACK_API_KEY=

# ── CORS (browser origins for ecojindu-web + ecojindu-admin) ─
# Local only is fine for docker-compose. On Cloud Run you MUST include every
# live frontend origin (both *.us-central1.run.app and *-xxxxx-uc.a.run.app
# forms are distinct). Example production value:
# CORS_ORIGINS=https://ecojindu-web-480235407496.us-central1.run.app,https://ecojindu-web-d7apfb4v6q-uc.a.run.app,https://ecojindu-admin-480235407496.us-central1.run.app,https://ecojindu-admin-d7apfb4v6q-uc.a.run.app,https://ecojindu.ng,https://www.ecojindu.ng,https://admin.ecojindu.ng,http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate limiting (auth endpoints) ───────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Company / branding (used in emails + SMS) ────────────────
COMPANY_NAME="Ecojindu Shuttle"
COMPANY_EMAIL=jinduinc@gmail.com
COMPANY_PHONE=+2348154471570
COMPANY_WHATSAPP=+2348154471570
COMPANY_SOCIAL=@ecojindu.ng
WEB_BASE_URL=http://localhost:3000
